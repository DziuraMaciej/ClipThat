<ui:FluentWindow x:Class="ClipThat.UI.Dialogs.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Usuń nagranie"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 SizeToContent="WidthAndHeight"
                 MinWidth="380"
                 MaxWidth="460"
                 ShowInTaskbar="False"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Background="#202020"
                 TextElement.Foreground="#F3F3F3">

    <Border Background="#202020"
            BorderBrush="#323232"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header + Body -->
            <StackPanel Grid.Row="0"
                        Background="Transparent"
                        Margin="22,20,22,20"
                        MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="#26EF4444"
                            BorderBrush="#40EF4444"
                            BorderThickness="1"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <ui:SymbolIcon x:Name="DialogIcon"
                                       Symbol="Delete24"
                                       FontSize="20"
                                       Foreground="#EF4444"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleTextBlock"
                               Grid.Column="1"
                               Text="Usuń nagranie"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#F3F3F3"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <TextBlock x:Name="MessageTextBlock"
                           FontSize="13.5"
                           LineHeight="20"
                           Foreground="#D4D4D4"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="1"
                    Background="#181818"
                    BorderBrush="#2C2C2C"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <ui:Button x:Name="CancelButton"
                               Content="Anuluj"
                               IsCancel="True"
                               MinWidth="96"
                               Padding="16,8"
                               Margin="0,0,10,0"
                               Background="#2A2A2A"
                               MouseOverBackground="#343434"
                               PressedBackground="#232323"
                               BorderBrush="#3D3D3D"
                               MouseOverBorderBrush="#4B4B4B"
                               PressedBorderBrush="#383838"
                               Foreground="#F3F3F3"
                               FontSize="13"
                               FontWeight="Medium"
                               Click="CancelButton_Click">
                        <ui:Button.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#F3F3F3" />
                            </Style>
                        </ui:Button.Resources>
                    </ui:Button>

                    <ui:Button x:Name="ConfirmButton"
                               Content="Usuń"
                               MinWidth="96"
                               Padding="16,8"
                               Background="#DC2626"
                               MouseOverBackground="#B91C1C"
                               PressedBackground="#991B1B"
                               BorderBrush="#EF4444"
                               MouseOverBorderBrush="#DC2626"
                               PressedBorderBrush="#991B1B"
                               Foreground="#FFFFFF"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Click="ConfirmButton_Click">
                        <ui:Button.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Style>
                        </ui:Button.Resources>
                    </ui:Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
