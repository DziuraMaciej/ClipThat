<ui:FluentWindow x:Class="ClipThat.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:pages="clr-namespace:ClipThat.UI.Pages"
                 Title="ClipThat"
                 Width="1100"
                 Height="720"
                 MinWidth="760"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 Background="Transparent"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 TextElement.Foreground="#F3F3F3">

    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F3F3" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid TextElement.Foreground="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="ClipThat"
                     Height="36"
                     Padding="12,0,8,0"
                     Background="{DynamicResource AppRailBrush}"
                     CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico"
                              Width="16"
                              Height="16" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Resources>
                <Style TargetType="{x:Type ui:TitleBarButton}"
                       BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Width" Value="46" />
                </Style>
            </ui:TitleBar.Resources>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           Background="{DynamicResource AppRailBrush}"
                           FrameMargin="0"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           PaneDisplayMode="Left"
                           OpenPaneLength="210">
            <ui:NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </ui:NavigationView.Resources>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Ustawienia"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
                <ui:NavigationViewItem Content="Nagrania"
                                       Icon="{ui:SymbolIcon Video24}"
                                       TargetPageType="{x:Type pages:ClipsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="UpdateNavItem"
                                       Content="Aktualizacja"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       PreviewMouseLeftButtonUp="UpdateNavItem_PreviewMouseLeftButtonUp"
                                       PreviewKeyDown="UpdateNavItem_PreviewKeyDown" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
