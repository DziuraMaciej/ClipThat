<UserControl x:Class="ClipThat.UI.Controls.MonitorLayoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             TextElement.Foreground="#F3F3F3">
    <StackPanel>
        <Border Background="#1A1A1A"
                BorderBrush="#323232"
                BorderThickness="1"
                CornerRadius="8"
                Height="210"
                ClipToBounds="True">
            <Grid>
                <Canvas x:Name="LayoutCanvas"
                        Background="Transparent"
                        SizeChanged="LayoutCanvas_SizeChanged" />
                <TextBlock x:Name="EmptyStateText"
                           Text="Nie wykryto podłączonych monitorów."
                           Foreground="#A8A8A8"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectedMonitorSummaryText"
                       Grid.Column="0"
                       Foreground="#A8A8A8"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,12,0" />

            <ui:Button x:Name="IdentifyButton"
                       Grid.Column="1"
                       Content="Identyfikuj ekrany"
                       Appearance="Secondary"
                       Icon="{ui:SymbolIcon Desktop24}"
                       Click="IdentifyButton_Click" />
        </Grid>
    </StackPanel>
</UserControl>
