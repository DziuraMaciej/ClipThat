<UserControl x:Class="ClipThat.UI.Controls.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <Border x:Name="CaptureBorder"
                Focusable="True"
                Cursor="Hand"
                CornerRadius="6"
                Padding="12,9"
                Background="#1AFFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1.5"
                MouseLeftButtonDown="CaptureBorder_MouseLeftButtonDown"
                PreviewKeyDown="CaptureBorder_PreviewKeyDown"
                PreviewKeyUp="CaptureBorder_PreviewKeyUp"
                LostKeyboardFocus="CaptureBorder_LostKeyboardFocus">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="Keyboard24"
                               Opacity="0.8"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center" />

                <TextBlock x:Name="HotkeyDisplayText"
                           Grid.Column="1"
                           Text="Alt + F10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="HintText"
                           Grid.Column="2"
                           Text="Kliknij, aby zmienić"
                           FontSize="12"
                           Opacity="0.6"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Border x:Name="WarningBanner"
                Visibility="Collapsed"
                Margin="0,6,0,0"
                CornerRadius="6"
                Padding="10,7"
                Background="#29F59E0B"
                BorderBrush="#88F59E0B"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0"
                               Symbol="Warning24"
                               Foreground="#FFFBBF24"
                               Margin="0,1,8,0"
                               VerticalAlignment="Top" />

                <TextBlock x:Name="WarningText"
                           Grid.Column="1"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#FFFDE68A" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
