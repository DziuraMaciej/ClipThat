<Page x:Class="ClipThat.UI.Pages.ClipsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:ClipThat.UI.Controls"
      Title="Nagrania"
      Background="Transparent"
      TextElement.Foreground="#F3F3F3"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F3F3" />
        </Style>

        <Style x:Key="ClipCardListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource AppClipItemBrush}"
                                BorderBrush="#323232"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Cursor="Hand">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#2D2D2D" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#424242" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SystemAccentTintBrush}" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportModeRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#363636" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="OuterDot"
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        BorderBrush="#77FFFFFF"
                                        BorderThickness="1.5"
                                        Margin="0,0,9,0"
                                        VerticalAlignment="Center">
                                    <Ellipse x:Name="InnerDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource SystemAccentColorPrimaryBrush}"
                                             Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#2E2E2E" />
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#484848" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="{DynamicResource SystemAccentTintBrush}" />
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="OuterDot" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" TextElement.Foreground="#F3F3F3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Left Column: Full-Height Flush Collapsible Secondary Navigation Sidebar -->
        <Border x:Name="ClipsListContainer"
                Grid.Column="0"
                Width="290"
                Margin="0"
                Padding="0"
                CornerRadius="0"
                ClipToBounds="True"
                Background="{DynamicResource AppCardBrush}"
                BorderBrush="#2D2D2D"
                BorderThickness="0,0,1,0">
            <Grid Width="289" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Header aligned horizontally with main NavigationView hamburger button -->
                <Grid x:Name="ClipsListHeaderGrid"
                      Grid.Row="0"
                      Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ui:Button x:Name="ToggleClipsListButton"
                               Grid.Column="0"
                               Width="40"
                               Height="38"
                               Margin="4,0,4,0"
                               Padding="0"
                               FontSize="16"
                               Foreground="#F3F3F3"
                               Appearance="Transparent"
                               BorderThickness="0"
                               CornerRadius="4"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               Icon="{ui:SymbolIcon ChevronLeft20}"
                               ToolTip="Zwiń listę nagrań"
                               Click="ToggleClipsListButton_Click" />

                    <TextBlock x:Name="ClipsListTitleText"
                               Grid.Column="1"
                               Text="Lista nagrań"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#F3F3F3"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="4,0,12,0" />
                </Grid>

                <!-- Collapsible Clips List Content -->
                <Grid x:Name="ClipsListBodyGrid"
                      Grid.Row="1"
                      Margin="12,0,12,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="FolderPathText"
                                   FontSize="11.5"
                                   Foreground="#A8A8A8"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,10" />
                        <UniformGrid Columns="2">
                            <ui:Button Content="Odśwież"
                                       Icon="{ui:SymbolIcon ArrowClockwise24}"
                                       FontSize="12.5"
                                       Padding="8,6"
                                       HorizontalAlignment="Stretch"
                                       Margin="0,0,3,0"
                                       Click="RefreshButton_Click" />
                            <ui:Button Content="Otwórz folder"
                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                       FontSize="12.5"
                                       Padding="8,6"
                                       HorizontalAlignment="Stretch"
                                       Margin="3,0,0,0"
                                       Click="OpenFolderButton_Click" />
                        </UniformGrid>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="ClipsListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,0,4,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemContainerStyle="{StaticResource ClipCardListBoxItemStyle}"
                                 SelectionChanged="ClipsListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding FormattedDate}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F3F3F3"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Grid.Column="1"
                                                    Background="#22FFFFFF"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedDuration}"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F3F3F3" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding FileName}"
                                                   FontSize="12"
                                                   Foreground="#A8A8A8"
                                                   Margin="0,3,0,8"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FilePath}" />

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FormattedSize}"
                                                           FontSize="11.5"
                                                           Foreground="#A8A8A8"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text=" · "
                                                           FontSize="11.5"
                                                           Foreground="#A8A8A8"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding AudioTrackBadge}"
                                                           FontSize="11.5"
                                                           Foreground="#A8A8A8"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <ui:Button Grid.Column="1"
                                                       Content="Usuń"
                                                       Icon="{ui:SymbolIcon Delete24}"
                                                       Appearance="Secondary"
                                                       FontSize="11.5"
                                                       Padding="8,4"
                                                       Tag="{Binding}"
                                                       ToolTip="Usuń nagranie z dysku"
                                                       Click="DeleteClipButton_Click" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="EmptyStatePanel"
                                Background="{DynamicResource AppClipItemBrush}"
                                BorderBrush="#323232"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Video24"
                                               FontSize="28"
                                               Foreground="#A8A8A8"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8" />
                                <TextBlock Text="Brak zapisanych nagrań"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#F3F3F3"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="Zapisane powtórki .mp4 pojawią się tutaj automatycznie."
                                           FontSize="12"
                                           Foreground="#A8A8A8"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Column: Podgląd i montaż (workspace canvas) -->
        <ScrollViewer x:Name="EditorScrollViewer"
                      Grid.Column="1"
                      Background="{DynamicResource AppWorkspaceBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      SizeChanged="EditorScrollViewer_SizeChanged">
            <StackPanel x:Name="EditorContentPanel"
                        Background="Transparent"
                        Margin="20,14,20,18">

                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Podgląd i montaż"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#F3F3F3" />
                        <TextBlock x:Name="SelectedClipSubtitleText"
                                   Text="Wybierz nagranie z listy po lewej stronie"
                                   FontSize="12"
                                   Foreground="#A8A8A8"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:Button x:Name="OpenExternalPlayerButton"
                               Grid.Column="1"
                               Content="Otwórz plik"
                               Icon="{ui:SymbolIcon Open24}"
                               Appearance="Secondary"
                               VerticalAlignment="Center"
                               IsEnabled="False"
                               Click="OpenExternalPlayerButton_Click" />
                </Grid>

                <!-- Video Preview & Unified Playback/Trim Card -->
                <ui:Card Margin="0,0,0,10"
                         Padding="12"
                         Background="{DynamicResource AppCardBrush}"
                         BorderBrush="#2E2E2E"
                         BorderThickness="1">
                    <StackPanel>
                        <Border x:Name="VideoPreviewBorder"
                                Background="#FF09090B"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="260"
                                Height="360"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonUp="VideoSurface_MouseLeftButtonUp">
                            <Grid>
                                <MediaElement x:Name="PreviewMediaElement"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              ScrubbingEnabled="True"
                                              Stretch="Uniform"
                                              IsMuted="True"
                                              Volume="0"
                                              MediaOpened="PreviewMediaElement_MediaOpened"
                                              MediaEnded="PreviewMediaElement_MediaEnded"
                                              MediaFailed="PreviewMediaElement_MediaFailed" />

                                <StackPanel x:Name="NoPreviewOverlay"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="20">
                                    <ui:SymbolIcon Symbol="Video24"
                                                   FontSize="34"
                                                   Foreground="#A8A8A8"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8" />
                                    <TextBlock Text="Brak wybranego nagrania"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#F3F3F3"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Kliknij klip na liście, aby wyświetlić podgląd i przyciąć nagranie."
                                               FontSize="12"
                                               Foreground="#A8A8A8"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <Border x:Name="AudioLoadingOverlay"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Margin="12"
                                        Padding="10,6"
                                        CornerRadius="6"
                                        Background="#D9121216"
                                        BorderBrush="#36FFFFFF"
                                        BorderThickness="1"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing Width="15"
                                                         Height="15"
                                                         IsIndeterminate="True"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center" />
                                        <TextBlock x:Name="AudioLoadingText"
                                                   Text="Ładowanie ścieżek audio..."
                                                   FontSize="12"
                                                   Foreground="#F3F3F3"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Unified Playback + Trim Bar -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Button x:Name="PlayPauseButton"
                                       Grid.Column="0"
                                       Icon="{ui:SymbolIcon Play24}"
                                       Appearance="Secondary"
                                       Width="40"
                                       Height="36"
                                       Padding="0"
                                       HorizontalContentAlignment="Center"
                                       VerticalContentAlignment="Center"
                                       VerticalAlignment="Center"
                                       ToolTip="Odtwórz"
                                       IsEnabled="False"
                                       Margin="0,0,10,0"
                                       Click="PlayPauseButton_Click" />

                            <controls:RangeTrimSlider x:Name="TrimRangeSlider"
                                                      Grid.Column="1"
                                                      Minimum="0"
                                                      Maximum="1"
                                                      StartValue="0"
                                                      EndValue="1"
                                                      CurrentPosition="0"
                                                      VerticalAlignment="Center"
                                                      IsEnabled="False"
                                                      Margin="0,0,10,0"
                                                      ThumbDragStarted="TrimRangeSlider_ThumbDragStarted"
                                                      ThumbDragCompleted="TrimRangeSlider_ThumbDragCompleted"
                                                      StartChanged="TrimRangeSlider_StartChanged"
                                                      EndChanged="TrimRangeSlider_EndChanged"
                                                      PositionSeekStarted="TrimRangeSlider_PositionSeekStarted"
                                                      PositionSeekRequested="TrimRangeSlider_PositionSeekRequested"
                                                      PositionSeekCompleted="TrimRangeSlider_PositionSeekCompleted" />

                            <TextBlock x:Name="TimeReadoutText"
                                       Grid.Column="2"
                                       Text="00:00 / 00:00"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F3F3"
                                       VerticalAlignment="Center"
                                       MinWidth="84"
                                       TextAlignment="Right" />
                        </Grid>

                        <!-- Clean Trim Summary Row -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Początek: "
                                           FontSize="12"
                                           Foreground="#A8A8A8"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="TrimStartText"
                                           Text="00:00"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F3F3F3"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource SystemAccentTintBrush}"
                                    BorderBrush="{DynamicResource SystemAccentBorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8,2"
                                    Margin="8,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedLengthText"
                                           Text="Wybrana długość: 00:00"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F3F3F3" />
                            </Border>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TrimEndText"
                                           Text="00:00"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F3F3F3"
                                           VerticalAlignment="Center" />
                                <TextBlock Text=" Koniec"
                                           FontSize="12"
                                           Foreground="#A8A8A8"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Głośność ścieżek Card -->
                <ui:Card Margin="0,0,0,10"
                         Padding="14,12"
                         Background="{DynamicResource AppCardBrush}"
                         BorderBrush="#2E2E2E"
                         BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Głośność ścieżek"
                                       FontSize="14.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F3F3"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="AudioTracksHintText"
                                       Grid.Column="1"
                                       Text=""
                                       FontSize="11.5"
                                       Foreground="#A8A8A8"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Dźwięk z systemu -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Dźwięk z systemu"
                                       FontSize="12.5"
                                       Foreground="#F3F3F3"
                                       VerticalAlignment="Center" />
                            <ui:Button x:Name="SystemMuteButton"
                                       Grid.Column="1"
                                       Icon="{ui:SymbolIcon Speaker224}"
                                       Appearance="Secondary"
                                       Padding="7,5"
                                       Margin="0,0,10,0"
                                       ToolTip="Wycisz / odcisz dźwięk z systemu"
                                       IsEnabled="False"
                                       Click="SystemMuteButton_Click" />
                            <Slider x:Name="SystemVolumeSlider"
                                    Grid.Column="2"
                                    Minimum="0"
                                    Maximum="200"
                                    Value="100"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    ValueChanged="SystemVolumeSlider_ValueChanged" />
                            <TextBlock x:Name="SystemVolumeText"
                                       Grid.Column="3"
                                       Text="100%"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F3F3"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Mikrofon -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="46" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Mikrofon"
                                       FontSize="12.5"
                                       Foreground="#F3F3F3"
                                       VerticalAlignment="Center" />
                            <ui:Button x:Name="MicMuteButton"
                                       Grid.Column="1"
                                       Icon="{ui:SymbolIcon Mic24}"
                                       Appearance="Secondary"
                                       Padding="7,5"
                                       Margin="0,0,10,0"
                                       ToolTip="Wycisz / odcisz mikrofon"
                                       IsEnabled="False"
                                       Click="MicMuteButton_Click" />
                            <Slider x:Name="MicVolumeSlider"
                                    Grid.Column="2"
                                    Minimum="0"
                                    Maximum="200"
                                    Value="100"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    ValueChanged="MicVolumeSlider_ValueChanged" />
                            <TextBlock x:Name="MicVolumeText"
                                       Grid.Column="3"
                                       Text="100%"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F3F3"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Eksport Card -->
                <ui:Card Margin="0,0,0,4"
                         Padding="14,12"
                         Background="{DynamicResource AppCardBrush}"
                         BorderBrush="#2E2E2E"
                         BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Eksport"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="#F3F3F3"
                                   Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <RadioButton x:Name="MixSingleTrackRadio"
                                         Grid.Row="0"
                                         GroupName="ClipExportModeGroup"
                                         Style="{StaticResource ExportModeRadioStyle}"
                                         Content="Zmiksuj do jednej ścieżki audio"
                                         IsChecked="True" />

                            <RadioButton x:Name="KeepSeparateTracksRadio"
                                         Grid.Row="2"
                                         GroupName="ClipExportModeGroup"
                                         Style="{StaticResource ExportModeRadioStyle}"
                                         Content="Zachowaj osobne ścieżki audio" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox x:Name="ExportFileNameTextBox"
                                            Grid.Column="0"
                                            PlaceholderText="Nazwa pliku wyjściowego..."
                                            VerticalAlignment="Center"
                                            IsEnabled="False"
                                            TextChanged="ExportFileNameTextBox_TextChanged" />

                                <Border Grid.Column="1"
                                        Background="#262626"
                                        BorderBrush="#363636"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="9,0"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Stretch"
                                        IsHitTestVisible="False">
                                    <TextBlock Text=".mp4"
                                               FontSize="12.5"
                                               Foreground="#A8A8A8"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ui:Button x:Name="ExportButton"
                                           Content="Eksportuj przycięty klip"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon Save24}"
                                           Padding="18,8"
                                           VerticalAlignment="Center"
                                           IsEnabled="False"
                                           Click="ExportButton_Click">
                                    <ui:Button.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
                                        </Style>
                                    </ui:Button.Resources>
                                </ui:Button>

                                <ui:Button x:Name="CancelExportButton"
                                           Content="Anuluj"
                                           Appearance="Secondary"
                                           Padding="14,8"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           Click="CancelExportButton_Click" />
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="ExportProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="6"
                                     Margin="0,10,0,0"
                                     Visibility="Collapsed" />

                        <TextBlock x:Name="ExportStatusText"
                                   FontSize="12"
                                   Foreground="#A8A8A8"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
