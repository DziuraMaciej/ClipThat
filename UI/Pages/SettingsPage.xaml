<Page x:Class="ClipThat.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ustawienia"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel MaxWidth="760">

            <TextBlock Text="Ustawienia nagrywania"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Skonfiguruj bufor powtórek w tle, monitor, audio oraz parametry kodowania."
                       Opacity="0.7"
                       Margin="0,0,0,16" />

            <!-- Status & Quick Actions -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Stan silnika powtórek"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock x:Name="EngineStatusText"
                                   Text="Oczekiwanie..."
                                   Opacity="0.8"
                                   Margin="0,4,12,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="SaveReplayButton"
                                   Content="Zapisz powtórkę teraz"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Margin="0,0,8,0"
                                   Click="SaveReplayButton_Click" />
                        <ui:Button x:Name="ToggleRecordingButton"
                                   Content="Wstrzymaj nagrywanie"
                                   Appearance="Secondary"
                                   Click="ToggleRecordingButton_Click" />
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Capture Source -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Monitor do nagrywania"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />
                    <ComboBox x:Name="MonitorComboBox"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
            </ui:Card>

            <!-- Audio Devices -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Audio"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,12" />

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Dźwięk z systemu"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="SystemAudioComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AudioDevice_SelectionChanged" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Mikrofon"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="MicrophoneComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AudioDevice_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Quality & Buffer -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Jakość i bufor powtórek"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Czas trwania bufora" VerticalAlignment="Center" />
                        <TextBlock x:Name="DurationValueText"
                                   Grid.Column="1"
                                   Text="5 min"
                                   FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="DurationSlider"
                            Minimum="1"
                            Maximum="10"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,16"
                            ValueChanged="QualityInput_Changed" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Rozdzielczość" Margin="0,0,0,6" />
                            <ComboBox x:Name="ResolutionComboBox"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectionChanged="QualityInput_Changed" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Klatki na sekundę (FPS)" Margin="0,0,0,6" />
                            <ComboBox x:Name="FpsComboBox"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectionChanged="QualityInput_Changed" />
                        </StackPanel>
                    </Grid>

                    <!-- Live Resource Estimate -->
                    <Border Background="#18FFFFFF"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Bitrate wideo" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="BitrateEstimateText" Text="16,0 Mbps" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Szacowany RAM" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="RamEstimateText" Text="720 MB" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Szacowany rozmiar pliku" FontSize="12" Opacity="0.7" />
                                <TextBlock x:Name="DiskEstimateText" Text="600 MB" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Output Directory -->
            <ui:Card Margin="0,0,0,12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Folder zapisu nagrań"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="OutputDirectoryTextBox"
                                    Grid.Column="0"
                                    IsReadOnly="True"
                                    Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1"
                                   Content="Zmień folder"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Click="BrowseOutputDirectoryButton_Click" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!-- Startup Behavior -->
            <ui:Card Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Uruchamianie"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,12" />
                    <ui:ToggleSwitch x:Name="StartWithWindowsSwitch"
                                     Content="Uruchamiaj z systemem Windows"
                                     Margin="0,0,0,10" />
                    <ui:ToggleSwitch x:Name="StartRecordingOnLaunchSwitch"
                                     Content="Rozpocznij nagrywanie przy uruchomieniu" />
                </StackPanel>
            </ui:Card>

            <!-- Save Button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveFeedbackText"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           Margin="0,0,12,0" />
                <ui:Button x:Name="SaveSettingsButton"
                           Content="Zapisz ustawienia"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon Checkmark24}"
                           Click="SaveSettingsButton_Click" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
