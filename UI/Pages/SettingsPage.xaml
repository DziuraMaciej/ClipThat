<Page x:Class="ClipThat.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:ClipThat.UI.Controls"
      xmlns:models="clr-namespace:ClipThat.Models"
      Title="Ustawienia"
      Background="Transparent"
      TextElement.Foreground="#F3F3F3"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F3F3F3" />
        </Style>

        <Style x:Key="SegmentedOptionRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F3F3F3" />
            <Setter Property="Background" Value="#262626" />
            <Setter Property="BorderBrush" Value="#363636" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2E2E2E" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#484848" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SystemAccentTintBrush}" />
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- Main scrollable workspace canvas -->
    <ScrollViewer Background="{DynamicResource AppWorkspaceBrush}"
                  TextElement.Foreground="#F3F3F3"
                  VerticalScrollBarVisibility="Auto"
                  Padding="24,16,24,24">
        <StackPanel MaxWidth="800">

            <TextBlock Text="Ustawienia"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#F3F3F3"
                       Margin="0,0,0,4" />
            <TextBlock Text="Wszystkie zmiany zapisują się automatycznie i natychmiast aktualizują bufor powtórek."
                       Foreground="#A8A8A8"
                       Margin="0,0,0,16" />

            <!-- Status & Quick Action Header -->
            <ui:Card Margin="0,0,0,12"
                     Padding="16"
                     Background="{DynamicResource AppCardBrush}"
                     BorderBrush="#2E2E2E"
                     BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="10"
                                     Height="10"
                                     Fill="#FF71717A"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineStatusTitleText"
                                       Text="Wstrzymano"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Foreground="#F3F3F3"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="EngineStatusDetailText"
                                   Text=""
                                   Foreground="#A8A8A8"
                                   FontSize="12.5"
                                   Margin="18,4,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="ToggleRecordingButton"
                                   Content="Wznów"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Margin="0,0,8,0"
                                   Click="ToggleRecordingButton_Click" />
                        <ui:Button x:Name="SaveReplayButton"
                                   Content="Zapisz powtórkę"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Click="SaveReplayButton_Click">
                            <ui:Button.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
                                </Style>
                            </ui:Button.Resources>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Wybór ekranu -->
            <ui:Card Margin="0,0,0,12"
                     Padding="16"
                     Background="{DynamicResource AppCardBrush}"
                     BorderBrush="#2E2E2E"
                     BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Wybór ekranu"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,12" />
                    <controls:MonitorLayoutControl x:Name="MonitorLayout" />
                </StackPanel>
            </ui:Card>

            <!-- Jakość i bufor powtórki -->
            <ui:Card Margin="0,0,0,12"
                     Padding="16"
                     Background="{DynamicResource AppCardBrush}"
                     BorderBrush="#2E2E2E"
                     BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Jakość i bufor powtórki"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Czas trwania bufora"
                                   Foreground="#F3F3F3"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DurationValueText"
                                   Grid.Column="1"
                                   Text="5 min"
                                   FontWeight="SemiBold"
                                   Foreground="#F3F3F3" />
                    </Grid>
                    <Slider x:Name="DurationSlider"
                            Minimum="1"
                            Maximum="10"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,14"
                            ValueChanged="DurationSlider_ValueChanged" />

                    <TextBlock Text="Rozdzielczość"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="5" Margin="0,0,0,14">
                        <RadioButton x:Name="Res240Radio"
                                     GroupName="ResolutionGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Tag="{x:Static models:ResolutionPreset.P240}"
                                     Content="240p"
                                     Checked="ResolutionRadio_Checked" />
                        <RadioButton x:Name="Res360Radio"
                                     GroupName="ResolutionGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Tag="{x:Static models:ResolutionPreset.P360}"
                                     Content="360p"
                                     Checked="ResolutionRadio_Checked" />
                        <RadioButton x:Name="Res480Radio"
                                     GroupName="ResolutionGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Tag="{x:Static models:ResolutionPreset.P480}"
                                     Content="480p"
                                     Checked="ResolutionRadio_Checked" />
                        <RadioButton x:Name="Res720Radio"
                                     GroupName="ResolutionGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Tag="{x:Static models:ResolutionPreset.P720}"
                                     Content="720p"
                                     Checked="ResolutionRadio_Checked" />
                        <RadioButton x:Name="Res1080Radio"
                                     GroupName="ResolutionGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Margin="0"
                                     Tag="{x:Static models:ResolutionPreset.P1080}"
                                     Content="1080p"
                                     Checked="ResolutionRadio_Checked" />
                    </UniformGrid>

                    <TextBlock Text="Klatki na sekundę"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,8" />
                    <UniformGrid Columns="2" HorizontalAlignment="Left" Width="220" Margin="0,0,0,16">
                        <RadioButton x:Name="Fps30Radio"
                                     GroupName="FpsGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Tag="30"
                                     Content="30 FPS"
                                     Checked="FpsRadio_Checked" />
                        <RadioButton x:Name="Fps60Radio"
                                     GroupName="FpsGroup"
                                     Style="{StaticResource SegmentedOptionRadioStyle}"
                                     Margin="0"
                                     Tag="60"
                                     Content="60 FPS"
                                     Checked="FpsRadio_Checked" />
                    </UniformGrid>

                    <!-- Live Resource & Storage Preview Card -->
                    <Border Background="#262626"
                            BorderBrush="#333333"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Szacowane zużycie RAM:"
                                           FontSize="12"
                                           Foreground="#A8A8A8" />
                                <TextBlock x:Name="RamEstimateText"
                                           Text="~720 MB"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="#F3F3F3"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Szacowany rozmiar klipu na dysku:"
                                           FontSize="12"
                                           Foreground="#A8A8A8" />
                                <TextBlock x:Name="DiskEstimateText"
                                           Text="~600 MB"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="#F3F3F3"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Docelowy bitrate wideo:"
                                           FontSize="12"
                                           Foreground="#A8A8A8" />
                                <TextBlock x:Name="BitrateEstimateText"
                                           Text="16,0 Mbps"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           Foreground="#F3F3F3"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ui:Card>

            <!-- Urządzenia audio -->
            <ui:Card Margin="0,0,0,12"
                     Padding="16"
                     Background="{DynamicResource AppCardBrush}"
                     BorderBrush="#2E2E2E"
                     BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Urządzenia audio"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,12" />

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Dźwięk z systemu"
                                   Foreground="#F3F3F3"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="SystemAudioComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AudioDevice_SelectionChanged" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Mikrofon"
                                   Foreground="#F3F3F3"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="MicrophoneComboBox"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="AudioDevice_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!-- Zapis plików i skrót -->
            <ui:Card Margin="0,0,0,12"
                     Padding="16"
                     Background="{DynamicResource AppCardBrush}"
                     BorderBrush="#2E2E2E"
                     BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Zapis plików i skrót"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Folder zapisu nagrań"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="OutputDirectoryTextBox"
                                    Grid.Column="0"
                                    IsReadOnly="True"
                                    Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1"
                                   Content="Wybierz folder..."
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Margin="0,0,8,0"
                                   Click="BrowseOutputDirectoryButton_Click" />
                        <ui:Button Grid.Column="2"
                                   Content="Otwórz folder"
                                   Appearance="Secondary"
                                   Click="OpenOutputFolderButton_Click" />
                    </Grid>

                    <TextBlock x:Name="FilenamePreviewText"
                               Text="Format nazwy: sekmingodzdzienmiesrok.mp4 (np. 45121526112026.mp4)"
                               FontSize="12"
                               Foreground="#A8A8A8"
                               Margin="0,8,0,14" />

                    <TextBlock Text="Skrót klawiszowy zapisu:"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,6" />
                    <controls:HotkeyBox x:Name="SaveHotkeyBox" />
                </StackPanel>
            </ui:Card>

            <!-- Uruchamianie w tle -->
            <ui:Card Margin="0,0,0,8"
                     Padding="16"
                     Background="{DynamicResource AppCardBrush}"
                     BorderBrush="#2E2E2E"
                     BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Uruchamianie w tle"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="#F3F3F3"
                               Margin="0,0,0,12" />
                    <ui:ToggleSwitch x:Name="StartWithWindowsSwitch"
                                     Content="Uruchamiaj ClipThat po starcie systemu Windows (w ukrytym zasobniku)"
                                     Margin="0,0,0,10"
                                     Checked="StartupSwitch_Changed"
                                     Unchecked="StartupSwitch_Changed" />
                    <ui:ToggleSwitch x:Name="StartRecordingOnLaunchSwitch"
                                     Content="Rozpocznij nagrywanie od razu po uruchomieniu aplikacji"
                                     Checked="StartRecordingOnLaunchSwitch_Changed"
                                     Unchecked="StartRecordingOnLaunchSwitch_Changed" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
