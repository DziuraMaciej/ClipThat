<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ClipThat</RootNamespace>
    <AssemblyName>ClipThat</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RollForward>Major</RollForward>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClipThat.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Prevent CS0104 ambiguities between WPF and WinForms/System.Drawing when both UseWPF and UseWindowsForms are enabled -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="ClipThat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <Target Name="EnsureFfmpegAsset"
          BeforeTargets="BeforeBuild;AssignTargetPaths;PrepareResourceNames"
          Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(MSBuildProjectDirectory)\Assets\ffmpeg.exe')">
    <Message Text="Pobieranie i weryfikacja SHA-256 dla ffmpeg.exe w folderze Assets..." Importance="high" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell -NoProfile -Command &quot;$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; New-Item -ItemType Directory -Force -Path 'Assets' | Out-Null; $id = [Guid]::NewGuid().ToString('N'); $zip = Join-Path $env:TEMP ('ffmpeg-clipthat-' + $id + '.zip'); $extract = Join-Path $env:TEMP ('ffmpeg-clipthat-extract-' + $id); $tmpExe = Join-Path 'Assets' ('ffmpeg-' + $id + '.tmp'); try { Invoke-WebRequest -Uri 'https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip' -OutFile $zip -UseBasicParsing; $shaRaw = (Invoke-WebRequest -Uri 'https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip.sha256' -UseBasicParsing).Content.Trim(); $expectedSha = ($shaRaw -split '\s+')[0].ToUpperInvariant(); if ($expectedSha -notmatch '^[0-9A-F]{64}$') { throw 'Nieprawidlowa odpowiedz SHA-256 dla archiwum FFmpeg.' }; $actualSha = (Get-FileHash -LiteralPath $zip -Algorithm SHA256).Hash.ToUpperInvariant(); if ($actualSha -ne $expectedSha) { throw ('Niezgodnosc sumy kontrolnej SHA-256 dla ffmpeg.zip: oczekiwano ' + $expectedSha + ', otrzymano ' + $actualSha) }; Expand-Archive -LiteralPath $zip -DestinationPath $extract -Force; $exe = Get-ChildItem -LiteralPath $extract -Filter 'ffmpeg.exe' -Recurse | Select-Object -First 1; if (-not $exe -or $exe.Length -lt 10485760) { throw 'Pobrany plik ffmpeg.exe jest nieprawidlowy.' }; Copy-Item -LiteralPath $exe.FullName -Destination $tmpExe -Force; Move-Item -LiteralPath $tmpExe -Destination 'Assets\ffmpeg.exe' -Force } finally { Remove-Item -LiteralPath $zip, $extract, $tmpExe -Recurse -Force -ErrorAction SilentlyContinue }&quot;" />
  </Target>

  <!-- Embed ffmpeg.exe only for self-contained single-file publishing; copy next to output for regular builds. -->
  <ItemGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="Assets\ffmpeg.exe" LogicalName="ClipThat.Assets.ffmpeg.exe" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishSingleFile)' != 'true'">
    <Content Include="Assets\ffmpeg.exe" Link="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <Target Name="SignOutputs"
          AfterTargets="Build"
          Inputs="$(TargetPath);$(TargetDir)$(TargetName).exe"
          Outputs="$(IntermediateOutputPath)SignOutputs.stamp"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec EnvironmentVariables="CLIPTHAT_TARGET_PATH=$(TargetPath);CLIPTHAT_TARGET_EXE=$(TargetDir)$(TargetName).exe"
          Command="powershell -NoProfile -Command &quot;$now = Get-Date; $certs = Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert | Where-Object { $_.Subject -in @('CN=ClipThatDev', 'CN=ClipThat Local') -and $_.HasPrivateKey -and $_.NotAfter -gt $now }; $cert = ($certs | Where-Object { $_.Subject -eq 'CN=ClipThatDev' } | Sort-Object NotAfter -Descending | Select-Object -First 1); if (-not $cert) { $cert = $certs | Sort-Object NotAfter -Descending | Select-Object -First 1 }; if ($cert) { foreach ($f in @($env:CLIPTHAT_TARGET_PATH, $env:CLIPTHAT_TARGET_EXE)) { if ($f -and (Test-Path -LiteralPath $f)) { Set-AuthenticodeSignature -FilePath $f -Certificate $cert | Out-Null } } }&quot;"
          IgnoreExitCode="true" />
    <Touch Files="$(IntermediateOutputPath)SignOutputs.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="SignPublishedOutputs"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <Exec EnvironmentVariables="CLIPTHAT_PUB_EXE=$(PublishDir)$(AssemblyName).exe;CLIPTHAT_PUB_DLL=$(PublishDir)$(AssemblyName).dll"
          Command="powershell -NoProfile -Command &quot;$now = Get-Date; $certs = Get-ChildItem Cert:\CurrentUser\My -CodeSigningCert | Where-Object { $_.Subject -in @('CN=ClipThatDev', 'CN=ClipThat Local') -and $_.HasPrivateKey -and $_.NotAfter -gt $now }; $cert = ($certs | Where-Object { $_.Subject -eq 'CN=ClipThatDev' } | Sort-Object NotAfter -Descending | Select-Object -First 1); if (-not $cert) { $cert = $certs | Sort-Object NotAfter -Descending | Select-Object -First 1 }; if ($cert) { foreach ($f in @($env:CLIPTHAT_PUB_EXE, $env:CLIPTHAT_PUB_DLL)) { if ($f -and (Test-Path -LiteralPath $f)) { Set-AuthenticodeSignature -FilePath $f -Certificate $cert | Out-Null } } }&quot;"
          IgnoreExitCode="true" />
  </Target>

</Project>
