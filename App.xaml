<Application x:Class="ClipThat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Dynamic surface brushes (initialized to inactive solid 3-tier dark grays) -->
            <SolidColorBrush x:Key="AppRailBrush" Color="#141414" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#202020" />
            <SolidColorBrush x:Key="AppClipItemBrush" Color="#262626" />
            <SolidColorBrush x:Key="AppWorkspaceBrush" Color="#2B2B2B" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
